# Copy to .env and fill in. .env is gitignored.

# --- HOST paths: absolute, specific to your machine ---------------------------
# Each file is bind-mounted read-only, one by one (they live in separate dirs).
SIRENS_HOST_PATH=/path/to/sirens.csv
MESSAGES_HOST_PATH=/path/to/messages.csv
LOCATIONS_HOST_PATH=/path/to/locations.json

# --- CONTAINER paths: what the application reads ------------------------------
SIRENS_CSV=/data/sirens.csv
MESSAGES_CSV=/data/messages.csv
LOCATIONS_JSON=/data/locations.json

# --- LLM (OpenAI-compatible LiteLLM endpoint) ---------------------------------
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL=

# Optional: only needed behind a proxy that re-signs TLS (e.g. corporate SSL
# inspection). CA_BUNDLE_HOST_PATH is used twice, for two separate problems
# the same corporate CA can cause:
#   - at BUILD time, `pip install` fails with "self-signed certificate in
#     certificate chain" -> Dockerfile trusts it via a build secret (see
#     compose.yaml's `secrets: ca_bundle`, and the Dockerfile itself).
#   - at RUNTIME, calling the LLM endpoint fails the same way -> the app
#     trusts it via CA_BUNDLE (see app/llm/client.py).
# Leave both unset otherwise - everything above becomes a no-op.
# CA_BUNDLE_HOST_PATH=/path/to/corporate-ca.crt
# CA_BUNDLE=/data/ca-bundle.crt

# --- Postgres -----------------------------------------------------------------
POSTGRES_DB=threat
POSTGRES_USER=threat
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://threat:change-me@db:5432/threat

# --- Tuning (optional - these are the defaults baked into app/config.py) ------
# EVENT_MAX_AGE_MINUTES=120
# ALERT_CONFIDENCE_THRESHOLD=0.6

# Wipe threat_events/ingested_messages and re-extract every message through
# the LLM on the next `ingest` run (same as `ingest --force`). Leave unset/
# false for the normal, idempotent path.
# REINGEST_FORCE=true

# --- Logging (read directly from the environment, not app/config.py's
# Settings - it needs to work before/independent of the rest of the app's
# configuration) ----------------------------------------------------------------

# true/1/yes: print a step-by-step trace of every /advise and /message
# request (see app/logging_config.py). Off by default - nothing to remove in
# production, just leave this unset.
# DEBUG=true
